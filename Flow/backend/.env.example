# Copy to .env. Leave OPENAI_API_KEY blank to use the rule-based fallback agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where the flow data lives. Defaults to the project's ../data folder so the
# backend and the canvas read the SAME source of truth.
FLOW_DATA_DIR=../data

# Comma-separated origins allowed to open the Socket.IO connection.
CHAINLIT_ALLOW_ORIGINS=http://localhost:3000
