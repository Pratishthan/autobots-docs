flowchart LR

  business_idea(["Business Idea"]):::start
  brd_business[/"Business BRD"/]:::manual
  solution_mapper["Solution Mapper"]:::system
  component_idea(["Component Idea"]):::start
  brd_component[/"Component BRD"/]:::manual
  slicer["Slicer"]:::system
  designer["Designer"]:::system
  nurture["Nurture"]:::system
  kbe["KBE"]:::system
  graph_server["Graph Server"]:::system
  ama(["AMA — Ask-Me-Anything"]):::end
